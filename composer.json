{
    "name": "dans6225/contact-warden",
    "description": "Portable, framework-agnostic PHP package for contact-form abuse detection, logging, and rejection.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "ext-pdo_sqlite": "*"
    },
    "autoload": {
        "psr-4": {
            "ContactWarden\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ContactWarden\\Tests\\": "tests/unit/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
